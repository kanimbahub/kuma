# Modèle de configuration Kuma (versionné dans Git, SANS secret).
# Les vraies valeurs vont dans /etc/kuma/kuma-<env>.env (jamais dans Git).
# Pour un nouveau serveur : copier ce fichier vers /etc/kuma/kuma-<env>.env,
# puis remplacer chaque A_REMPLACER par la vraie valeur.

POSTGRES_DB=kuma
POSTGRES_USER=kuma
POSTGRES_PASSWORD=A_REMPLACER
REDIS_PASSWORD=A_REMPLACER
KUMA_UID=1000
KUMA_GID=1000
XIVO_PBX_HOST=192.168.1.201
XIVO_CC_HOST=192.168.1.202
XIVO_API_LOGIN=kuma
XIVO_API_PASSWORD=A_REMPLACER
