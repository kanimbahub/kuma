{
  "version": "0.2",
  "language": "fr,en",
  "import": ["@cspell/dict-fr-fr/cspell-ext.json"],
  "ignorePaths": ["node_modules", "dist", "build", "coverage", "package-lock.json", ".git"],
  "words": [
    "kuma", "XiVO", "XuC", "confd", "WebRTC", "PBX",
    "NestJS", "nestjs", "TypeScript", "Vite", "Tailwind", "shadcn",
    "PostgreSQL", "postgres", "Redis", "BullMQ", "Caddy", "ghcr",
    "frontend", "backend", "deploy", "compose", "kanimbahub",
    "français", "english"
  ],
  "overrides": [
    {
      "filename": "**/locales/fr.json",
      "language": "fr",
      "ignoreRegExpList": ["/\"[A-Za-z0-9_.-]+\"\\s*:/g", "/\\{\\{[^}]*\\}\\}/g"]
    },
    {
      "filename": "**/locales/en.json",
      "language": "en",
      "ignoreRegExpList": ["/\"[A-Za-z0-9_.-]+\"\\s*:/g", "/\\{\\{[^}]*\\}\\}/g"]
    }
  ]
}
